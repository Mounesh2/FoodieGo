# ==============================================================================
# FoodieGo — Environment Configuration Template
# Copy this file to '.env' and fill in your values for production deployment.
# ==============================================================================

# Security
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,foodiego.yourdomain.com

# Database (Default uses local SQLite3 db.sqlite3)
# DATABASE_URL=postgres://user:password@localhost:5432/foodiego_db

# Static & Media Storage
# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
